{
    "manifest_version": 3,
    "name": "红美铃网页感知器",
    "version": "1.2",
    "description": "突破网页CSP限制，安全将当前网页文本直接发送给本地红美铃桌宠",
    "permissions": [
        "activeTab"
    ],
    "host_permissions": [
        "http://127.0.0.1:18088/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_end"
        }
    ]
}